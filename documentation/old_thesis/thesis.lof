\contentsline {figure}{\numberline {2.1}{\ignorespaces Example log-log plots of EI against fuel flow at reference conditions, as prescribed by the BFFM2. The percentage values refer to the thrust as a percentage of maximum thrust at SLS conditions \blx@tocontentsinit {0}\cite {AIR5715}.}}{20}{figure.caption.16}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Aircraft exhaust plume dynamical regimes. Wake distance behind aircraft $x_w = v_\infty \times t$ where $v_\infty $ is aircraft speed and $t$ is the post emission time \blx@tocontentsinit {0}\cite {Paoli2016, Gerz1998}.}}{23}{figure.caption.19}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Dilution ratio against plume age derived from empirical data. Marker shapes correspond to tracer species as displayed in legend. Markers with error bars correspond to characteristic values for the engine core (leftmost and lower) and bypass exits (rightmost and upper). The dashed curves near the core represent dilution on the jet axis, calculated for two engine types: CFM56 and RB211. The dotted curve represents large eddy simulation results from Gerz and Ehret \blx@tocontentsinit {0}\cite {Gerz1997}. The range of dilution values computed for large plumes ages by D{\"u}rbeck and Gerz \blx@tocontentsinit {0}\cite {Durbeck1996} are bounded by the triangle, top right of the figure. The dash-dotted line shows the interpolation that is represented by equation \eqref {N_equation}. From Schumann et al.\ \blx@tocontentsinit {0}\cite {Schumann1998}.}}{27}{figure.caption.22}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces MP model visual representation \blx@tocontentsinit {0}\cite {Kraabol2000a}. Plume length L was set to the distance travelled over 1 s (247 m in this scenario) with three out of eight concentric rings shown for each time step. $C_1 - C_3$ indicate the concentrations in each ring and the arrows represent mixing between the layers.}}{30}{figure.caption.25}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Evolution of \textbf {(a)} horizontal and \textbf {(b)} vertical plume radius over time, for MP model under assumed turbulent conditions \blx@tocontentsinit {0}\cite {Kraabol2000a}.}}{31}{figure.caption.26}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Aircraft capacity estimation against sector volume for a range of airspace scenarios \blx@tocontentsinit {0}\cite {Welch2007}. }}{37}{figure.caption.39}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Spatial (latitude, longitude and altitude) distribution of global aviation fuel burn from a range of aircraft emissions datasets \blx@tocontentsinit {0}\cite {Olsen2013}.}}{40}{figure.caption.40}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Temporal (diurnal and seasonal) distribution of global aviation fuel burn expressed as percentage from a range of aircraft emissions datasets \blx@tocontentsinit {0}\cite {Olsen2013}.}}{41}{figure.caption.41}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Lateral, longitudinal and vertical maximum plume overlap scenarios, based on nominal separation minima \blx@tocontentsinit {0}\cite {ICAOPANSDoc44442016}}}{43}{figure.caption.42}%
\contentsline {figure}{\numberline {2.10}{\ignorespaces Radiative forcing contributions from global aviation between 2000 and 2018 \blx@tocontentsinit {0}\cite {Lee2021}. Error bars represent 5--95\% confidence interval, with corresponding RF and ERF values shown in parentheses.}}{47}{figure.caption.43}%
\contentsline {figure}{\numberline {2.11}{\ignorespaces Visual representation of contrail radiative forcing, adapted from Karcher et al.\ \blx@tocontentsinit {0}\cite {Karcher2018}.}}{50}{figure.caption.48}%
